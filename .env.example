# Apni NVIDIA API key yahan daalo (build.nvidia.com se milti hai)
# Ya phir app ke andar Settings me paste kar do — dono chalega.
NVIDIA_API_KEY=

# Server port (default 3000)
PORT=3000

# --- Advanced (normally change karne ki zaroorat nahi) ---
# Microsoft TRELLIS (image/text -> 3D) invoke URL
TRELLIS_URL=https://ai.api.nvidia.com/v1/genai/microsoft/trellis
# NVCF polling status URL (long-running requests ke liye)
NVCF_STATUS_URL=https://ai.api.nvidia.com/v1/status/
# Text -> Image model (Text-to-3D pipeline ka pehla step, agar TRELLIS
# direct text accept na kare). Koi bhi NVIDIA genai image model URL chalega.
TEXT2IMG_URL=https://ai.api.nvidia.com/v1/genai/stabilityai/stable-diffusion-3-medium
